// {{.Slug}} accepts a provider-neutral, HMAC-authenticated document request
// and calls Hash's atomic automation API. Generated by
// `reactor new hash-esign-bridge {{.Slug}}` on {{.Date}}.
package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"sync"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	"github.com/bright-interaction/reactor/sdk/esign"
	hashesign "github.com/bright-interaction/reactor/sdk/esign/hash"
	"github.com/bright-interaction/reactor/sdk/idempotency"
	"github.com/bright-interaction/reactor/sdk/runtime"
	"github.com/bright-interaction/reactor/sdk/vault"
)

const (
	hashAPIKeyCredential = "hash-esign-{{.Slug}}"
	// Set this to the trusted Hash deployment. Never read it from the webhook.
	trustedHashBaseURL = ""
)

// templateProfiles is an operator-owned allowlist. External producers send a
// stable profile name, never an arbitrary Hash template UUID.
//
// Example:
//
//	"sales-partner-agreement-v1": "29ddcd70-1d59-41fc-8e25-bad316eea84d",
//
//nolint:gochecknoglobals // Reviewed workflow configuration.
var templateProfiles = map[string]string{}

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "1.0.0"}
	Trigger  = reactor.WebhookTrigger{Provider: "automation-v1"}
)

// hashRetryPolicy combines Reactor's bounded exponential backoff with Hash's
// bounded Retry-After hint. The mutex keeps the policy safe if a future
// runtime invokes retry decisions from a different goroutine.
type hashRetryPolicy struct {
	mu         sync.Mutex
	fallback   reactor.ExpBackoff
	retryAfter time.Duration
}

func (p *hashRetryPolicy) Observe(err error) {
	var apiErr *hashesign.APIError
	if !errors.As(err, &apiErr) || apiErr.RetryAfter <= 0 {
		return
	}
	p.mu.Lock()
	p.retryAfter = apiErr.RetryAfter
	p.mu.Unlock()
}

func (p *hashRetryPolicy) NextDelay(attempt int) (time.Duration, bool) {
	delay, ok := p.fallback.NextDelay(attempt)
	p.mu.Lock()
	retryAfter := p.retryAfter
	p.retryAfter = 0
	p.mu.Unlock()
	if !ok {
		return 0, false
	}
	if retryAfter > delay {
		delay = retryAfter
	}
	return delay, true
}

// MaxAttempts exposes the finite budget to Reactor's host-owned durable
// attempt counter. The Retry-After observation is process-local; after a hard
// crash Reactor reapplies the fallback backoff because the provider hint died
// with the workflow process.
func (p *hashRetryPolicy) MaxAttempts() int {
	return p.fallback.MaxAttempts()
}

// Run strictly validates the signed body, maps its profile through trusted
// configuration, and performs one idempotent Hash command.
func Run(ctx context.Context, flow reactor.Flow, raw json.RawMessage) error {
	event, err := esign.DecodeDocumentRequested(raw)
	if err != nil {
		// Detailed decoder errors can include producer-controlled values (for
		// example an unknown member name). Keep them out of workflow logs.
		return reactor.Permanent(errors.New("invalid e-signature request event"))
	}
	if trustedHashBaseURL == "" {
		return reactor.Permanent(errors.New("configure trustedHashBaseURL before enabling the workflow"))
	}
	templateID, ok := templateProfiles[event.Document.TemplateKey]
	if !ok || templateID == "" {
		return reactor.Permanent(errors.New("unconfigured e-signature template profile"))
	}

	request := hashesign.SignatureRequest{
		TemplateID:  templateID,
		Name:        event.Document.Name,
		Variables:   documentVariables(event),
		Recipients:  hashesign.Recipients(event.Document.Recipients),
		LawfulBasis: "contract",
		ExpiresAt:   event.Document.ExpiresAt,
	}
	commandKey := idempotency.Key(Workflow.Slug, "hash-create-and-send", "event_id", event.EventID)
	retryPolicy := &hashRetryPolicy{fallback: reactor.ExpBackoff{
		Max:  12,
		Base: 5 * time.Second,
		Cap:  5 * time.Minute,
	}}
	result, err := reactor.Step(flow, ctx, "hash-create-and-send", reactor.StepOpts{
		IdempotencyKey: commandKey,
		Timeout:        30 * time.Second,
		RetryPolicy:    retryPolicy,
	}, func(ctx context.Context) (hashesign.SignatureResult, error) {
		apiKey, err := vault.Get(ctx, hashAPIKeyCredential)
		if err != nil {
			return hashesign.SignatureResult{}, reactor.Permanent(fmt.Errorf("load Hash API credential: %w", err))
		}
		client, err := hashesign.NewClient(trustedHashBaseURL, string(apiKey.Reveal()), nil)
		if err != nil {
			return hashesign.SignatureResult{}, reactor.Permanent(err)
		}
		created, err := client.CreateAndSend(ctx, commandKey, request)
		if err == nil {
			return created, nil
		}
		if hashesign.IsRetryable(err) {
			retryPolicy.Observe(err)
			return hashesign.SignatureResult{}, reactor.Retryable(err)
		}
		return hashesign.SignatureResult{}, reactor.Permanent(err)
	})
	if err != nil {
		return fmt.Errorf("hash create-and-send: %w", err)
	}

	// Keep customer data and the producer-controlled event ID out of workflow
	// logs. The derived fingerprint, Hash IDs, and state are sufficient for
	// operations without encouraging producers to put personal data in IDs.
	flow.Logger().Info("Hash signature request accepted",
		"event_fingerprint", commandKey[:16],
		"automation_request_id", result.AutomationRequestID,
		"document_id", result.DocumentID,
		"status", result.Status,
		"replayed", result.Replayed)
	return nil
}

func documentVariables(event esign.DocumentRequested) map[string]string {
	variables := make(map[string]string, len(event.Document.Variables)+6)
	for key, value := range event.Document.Variables {
		variables[key] = value
	}
	// Canonical customer keys are derived from the normalized customer object,
	// so a conflicting free-form variable cannot impersonate another customer.
	variables["customer.external_id"] = event.Customer.ExternalID
	variables["customer.name"] = event.Customer.Name
	variables["customer.email"] = event.Customer.Email
	variables["customer.company_name"] = event.Customer.CompanyName
	variables["customer.phone"] = event.Customer.Phone
	variables["customer.locale"] = event.Customer.Locale
	return variables
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
