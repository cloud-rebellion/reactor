// Run manually after changing preparation validation. It proves the optional
// Google edge refuses events that Reactor or Hash would reject before callers
// persist the immutable outbox body.
function verifyPreparationValidationTestVectors() {
  const emailAtLimit = 'a'.repeat(64) + '@' + 'b'.repeat(61) + '.' +
    'c'.repeat(61) + '.' + 'd'.repeat(61) + '.com';
  function customer() {
    return {
      externalId: 'customer-1',
      tenantExternalId: 'tenant-1',
      name: 'a'.repeat(199) + String.fromCodePoint(0x1f4a1),
      email: emailAtLimit,
      locale: 'sv-SE',
      variables: {'contract.value': '8000'},
      expiresAt: '2026-09-01T12:10:00Z',
    };
  }
  const prepared = prepareHashESignDelivery(
    customer(), 'event-1', '2026-09-01T12:00:00Z');
  const event = parseStrictJSON_(prepared.raw_body);
  if (emailAtLimit.length !== 254 || event.occurred_at !== '2026-09-01T12:00:00Z' ||
      event.document.expires_at !== '2026-09-01T12:10:00Z' ||
      unicodeCodePointLength_(event.customer.name) !== 200) {
    throw new Error('preparation validation rejected or changed a valid boundary vector');
  }
  const variableBoundary = customer();
  variableBoundary.variables = {};
  variableBoundary.variables['_' + 'a'.repeat(199)] = 'x'.repeat(16 * 1024);
  prepareHashESignDelivery(variableBoundary, 'event-1', '2026-09-01T12:00:00Z');
  const timestampBoundary = customer();
  timestampBoundary.expiresAt = '2026-09-01T12:10:00.123456789+23:59';
  prepareHashESignDelivery(
    timestampBoundary, 'event-1', '2026-09-01T12:00:00.123456789+23:59');

  const invalid = [
    function() { const value = customer(); value.variables = []; return value; },
    function() { const value = customer(); value.variables = 'text'; return value; },
    function() { const value = customer(); value.variables = null; return value; },
    function() { const value = customer(); value.variables = {amount: null}; return value; },
    function() { const value = customer(); value.variables = {'contract-value': 'x'}; return value; },
    function() {
      const value = customer(); value.variables = {};
      value.variables['_' + 'a'.repeat(200)] = 'x'; return value;
    },
    function() {
      const value = customer(); value.variables = {amount: 'x'.repeat(16 * 1024 + 1)}; return value;
    },
    function() {
      const value = customer();
      value.variables = {};
      for (let index = 0; index < 201; index++) value.variables['v' + index] = 'x';
      return value;
    },
    function() { const value = customer(); value.name = 'a'.repeat(201); return value; },
    function() { const value = customer(); value.email = emailAtLimit + 'a'; return value; },
    function() { const value = customer(); value.locale = 'a'.repeat(36); return value; },
    function() { const value = customer(); value.externalId = 'a'.repeat(201); return value; },
    function() { const value = customer(); value.tenantExternalId = 'a'.repeat(201); return value; },
    function() { const value = customer(); value.expiresAt = '2026-09-01T12:09:59Z'; return value; },
  ];
  invalid.forEach(function(makeCustomer) {
    let rejected = false;
    try {
      prepareHashESignDelivery(makeCustomer(), 'event-1', '2026-09-01T12:00:00Z');
    } catch (err) {
      rejected = true;
    }
    if (!rejected) {
      throw new Error('preparation validation accepted an incompatible customer vector');
    }
  });
  let badOccurredAtRejected = false;
  try {
    prepareHashESignDelivery(customer(), 'event-1', '2026-02-30T12:00:00Z');
  } catch (err) {
    badOccurredAtRejected = true;
  }
  if (!badOccurredAtRejected) {
    throw new Error('preparation validation accepted an invalid RFC3339 calendar date');
  }
  [
    '2026-09-01T12:00:00.1234567890Z',
    '2026-09-01T12:00:00,1Z',
    '2026-09-01T12:00:00+24:00',
  ].forEach(function(timestamp) {
    let rejected = false;
    try {
      prepareHashESignDelivery(customer(), 'event-1', timestamp);
    } catch (err) {
      rejected = true;
    }
    if (!rejected) {
      throw new Error('preparation validation accepted non-canonical RFC3339');
    }
  });
  let subMillisecondLeadRejected = false;
  try {
    const value = customer();
    value.expiresAt = '2026-09-01T12:10:00.0000Z';
    prepareHashESignDelivery(value, 'event-1', '2026-09-01T12:00:00.0009Z');
  } catch (err) {
    subMillisecondLeadRejected = true;
  }
  if (!subMillisecondLeadRejected) {
    throw new Error('preparation validation lost sub-millisecond expiry precision');
  }
  return true;
}

// Run manually after changing parseStrictJSON_. It must reject duplicates at
// the root, in nested objects, and after JSON string escape decoding.
function verifyStrictJSONParserTestVectors() {
  const valid = parseStrictJSON_('{"accepted":true,"nested":{"event_id":"one"}}');
  if (valid.accepted !== true || valid.nested.event_id !== 'one') {
    throw new Error('strict JSON parser rejected a valid vector');
  }
  [
    '{"accepted":true,"accepted":false}',
    '{"nested":{"event_id":"one","event_id":"two"}}',
    '{"event_id":"one","\\u0065vent_id":"two"}',
  ].forEach(function(raw) {
    let rejected = false;
    try {
      parseStrictJSON_(raw);
    } catch (err) {
      rejected = true;
    }
    if (!rejected) {
      throw new Error('strict JSON parser accepted a duplicate member');
    }
  });
  return true;
}

// Run manually after changing response-header handling. Apps Script may expose
// repeated headers either as arrays or as folded values; both must fail closed.
function verifyResponseContentTypeTestVectors() {
  function response(headers) {
    return {getAllHeaders: function() { return headers; }};
  }
  [
    {'Content-Type': 'application/json'},
    {'content-type': 'Application/JSON; Charset=UTF-8'},
    {'CONTENT-TYPE': ['application/json; charset="utf-8"']},
  ].forEach(function(headers) {
    if (!hasExactJSONContentType_(response(headers))) {
      throw new Error('strict response Content-Type rejected a valid vector');
    }
  });
  [
    {},
    {'Content-Type': 'text/plain'},
    {'Content-Type': 'application/json; profile=v1'},
    {'Content-Type': 'application/json; charset=iso-8859-1'},
    {'Content-Type': ['application/json', 'application/json']},
    {'Content-Type': 'application/json', 'content-type': 'application/json'},
    {'Content-Type': 'application/json, text/plain'},
  ].forEach(function(headers) {
    if (hasExactJSONContentType_(response(headers))) {
      throw new Error('strict response Content-Type accepted an ambiguous vector');
    }
  });
  return true;
}
