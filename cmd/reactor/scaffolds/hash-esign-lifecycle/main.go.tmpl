// {{.Slug}} forwards automation-correlated Hash document lifecycle events to
// one trusted BrightCRM tenant. Generated by
// `reactor new hash-esign-lifecycle {{.Slug}}` on {{.Date}}.
package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"sync"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	brightcrm "github.com/bright-interaction/reactor/sdk/esign/brightcrm"
	hashesign "github.com/bright-interaction/reactor/sdk/esign/hash"
	"github.com/bright-interaction/reactor/sdk/idempotency"
	"github.com/bright-interaction/reactor/sdk/runtime"
	"github.com/bright-interaction/reactor/sdk/vault"
)

const (
	brightCRMLifecycleCredential = "brightcrm-esign-lifecycle-{{.Slug}}"
	// Both values are operator-owned configuration. Never read either value,
	// or a credential ID, from the webhook event.
	trustedHashOrgID        = ""
	trustedBrightCRMBaseURL = ""
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "1.0.0"}
	Trigger  = reactor.WebhookTrigger{Provider: "hash-v1"}
)

// crmRetryPolicy combines bounded Reactor backoff with BrightCRM's capped
// Retry-After hint. The client itself always performs a single HTTP attempt.
type crmRetryPolicy struct {
	mu         sync.Mutex
	fallback   reactor.ExpBackoff
	retryAfter time.Duration
}

func (p *crmRetryPolicy) Observe(err error) {
	var apiErr *brightcrm.APIError
	if !errors.As(err, &apiErr) || apiErr.RetryAfter <= 0 {
		return
	}
	p.mu.Lock()
	p.retryAfter = apiErr.RetryAfter
	p.mu.Unlock()
}

func (p *crmRetryPolicy) NextDelay(attempt int) (time.Duration, bool) {
	delay, ok := p.fallback.NextDelay(attempt)
	p.mu.Lock()
	retryAfter := p.retryAfter
	p.retryAfter = 0
	p.mu.Unlock()
	if !ok {
		return 0, false
	}
	if retryAfter > delay {
		delay = retryAfter
	}
	return delay, true
}

// MaxAttempts exposes the finite budget to Reactor's host-owned durable
// attempt counter. A hard crash loses the in-memory Retry-After observation,
// so resume uses the fallback schedule while preserving this total ceiling.
func (p *crmRetryPolicy) MaxAttempts() int {
	return p.fallback.MaxAttempts()
}

// Run validates the authenticated Hash envelope, discards all provider
// payload and recipient data, and forwards only the safe lifecycle projection.
func Run(ctx context.Context, flow reactor.Flow, raw json.RawMessage) error {
	if trustedHashOrgID == "" {
		return reactor.Permanent(errors.New("configure trustedHashOrgID before enabling the workflow"))
	}
	event, err := hashesign.DecodeLifecycleEvent(raw, trustedHashOrgID)
	if errors.Is(err, hashesign.ErrUncorrelatedDocument) {
		// Org-level Hash endpoints also receive manual/non-automation documents.
		// Acknowledge those without creating a failed run or contacting BrightCRM.
		flow.Logger().Info("Hash lifecycle event ignored", "reason", "not_automation_correlated")
		return nil
	}
	if err != nil {
		return reactor.Permanent(err)
	}
	if trustedBrightCRMBaseURL == "" {
		return reactor.Permanent(errors.New("configure trustedBrightCRMBaseURL before enabling the workflow"))
	}

	stepKey := idempotency.Key(Workflow.Slug, "brightcrm-lifecycle-writeback", "event_id", event.EventID)
	retryPolicy := &crmRetryPolicy{fallback: reactor.ExpBackoff{
		Max:  12,
		Base: 5 * time.Second,
		Cap:  5 * time.Minute,
	}}
	receipt, err := reactor.Step(flow, ctx, "brightcrm-lifecycle-writeback", reactor.StepOpts{
		IdempotencyKey: stepKey,
		Timeout:        20 * time.Second,
		RetryPolicy:    retryPolicy,
	}, func(ctx context.Context) (brightcrm.Receipt, error) {
		credential, err := vault.Get(ctx, brightCRMLifecycleCredential)
		if err != nil {
			return brightcrm.Receipt{}, reactor.Permanent(fmt.Errorf("load BrightCRM lifecycle credential: %w", err))
		}
		client, err := brightcrm.NewClient(trustedBrightCRMBaseURL, string(credential.Reveal()), nil)
		if err != nil {
			return brightcrm.Receipt{}, reactor.Permanent(err)
		}
		result, err := client.DeliverLifecycleEvent(ctx, event)
		if err == nil {
			return result, nil
		}
		if brightcrm.IsRetryable(err) {
			retryPolicy.Observe(err)
			return brightcrm.Receipt{}, reactor.Retryable(err)
		}
		return brightcrm.Receipt{}, reactor.Permanent(err)
	})
	if err != nil {
		return fmt.Errorf("BrightCRM lifecycle writeback: %w", err)
	}

	// The fingerprint is derived from the event ID; raw IDs, recipient data,
	// Hash payloads, and bearer values never enter workflow logs.
	flow.Logger().Info("Hash lifecycle event accepted by BrightCRM",
		"event_fingerprint", stepKey[:16],
		"kind", event.Kind,
		"deduped", receipt.Deduped)
	return nil
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
