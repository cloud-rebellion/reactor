[Unit]
Description=Reactor daemon
Documentation=https://github.com/bright-interaction/reactor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The reactor user owns /var/lib/reactor (master.key mode 0600,
# workflows/<slug>/workflow mode 0755). Create it with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
#     --home-dir /var/lib/reactor reactor
#   sudo install -d -m 0700 -o reactor -g reactor /var/lib/reactor
User=reactor
Group=reactor
WorkingDirectory=/var/lib/reactor

# First boot: run `reactor setup --root /var/lib/reactor` before enabling this
# unit. Setup creates the master key, runs migrations, seeds the first admin,
# and writes reactor.env. The unit intentionally does not run setup itself.
Environment=REACTOR_DB_URL=sqlite:///var/lib/reactor/reactor.db
# Older packages instructed operators to keep this file under /etc. Preserve
# those database and auth settings across upgrades; the setup-generated state
# file below takes precedence when both files exist.
EnvironmentFile=-/etc/reactor/reactor.env
# `reactor setup --root /var/lib/reactor` writes this file with assignments
# valid for both systemd and shell loading. Keep it beside the protected state
# so setup's generated database/auth configuration is the one this unit uses.
EnvironmentFile=-/var/lib/reactor/reactor.env
# Native packages bundle the SDK module used by MCP/dashboard workflow builds.
# The state env file is writable by the reactor user, so pin the module path
# in ExecStart after that file is loaded. Go 1.26.5+ must be installed on PATH.
# nfpm installs the release binary at /usr/bin/reactor. Keep the manual
# walkthrough on the same canonical path so package installs can start the
# exact unit they ship.
# The default listener is loopback so the local HTTP MCP/dashboard example
# cannot expose bearer-authenticated MCP on every interface. A reverse-proxy
# deployment may override this with a reviewed TLS/proxy configuration.
ExecStart=/usr/bin/env REACTOR_SDK_REPLACE=/usr/lib/reactor-sdk PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin /usr/bin/reactor serve --root /var/lib/reactor --addr 127.0.0.1:7777

# Hardening. Daemon needs network + the state dir; deny everything else.
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reactor
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Resource caps. Tune for your workload.
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
